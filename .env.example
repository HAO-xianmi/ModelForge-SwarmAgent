# ModelForge-Swarm configuration. Copy to .env and edit. Secrets MUST stay out of VCS.

# --- Operating mode defaults ---
MODELFORGE_MODE=practice                 # practice | contest_compliant | research
MODELFORGE_BUDGET_PROFILE=standard       # demo | standard | high_quality | research

# --- Storage ---
MODELFORGE_RUNS_DIR=./runs
DATABASE_URL=sqlite:///./modelforge.db   # or postgresql+psycopg://user:pass@host/db

# --- Queue (optional; synchronous local execution if unset) ---
# REDIS_URL=redis://localhost:6379/0

# --- LLM provider ---
MODELFORGE_LLM=mock                      # mock | openai | anthropic
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_API_KEY=sk-ant-...
MODELFORGE_LLM_MODEL=                     # provider-specific default if empty

# --- Sandbox ---
MODELFORGE_SANDBOX=auto                   # auto | docker | subprocess
MODELFORGE_SANDBOX_TIMEOUT=120            # seconds per execution
MODELFORGE_SANDBOX_MEMORY_MB=1024
MODELFORGE_SANDBOX_CPU=1.0
MODELFORGE_SANDBOX_IMAGE=modelforge-sandbox:latest

# --- Budgets / loop protection ---
MODELFORGE_MAX_DEBUG_RETRIES=3
MODELFORGE_MAX_MODEL_REVISIONS=2
MODELFORGE_MAX_REPORT_REVISIONS=2
MODELFORGE_MAX_TOTAL_LOOPS=12

# --- Uploads ---
MODELFORGE_MAX_UPLOAD_MB=50
